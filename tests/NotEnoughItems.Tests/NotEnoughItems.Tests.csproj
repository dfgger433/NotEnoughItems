<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <NeiSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'src', 'NotEnoughItems'))</NeiSourceDir>
    <GameRoot Condition="'$(GameRoot)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</GameRoot>
    <ManagedDir>$(GameRoot)/CasualtiesUnknown_Data/Managed</ManagedDir>
    <CUCoreLibPath Condition="'$(CUCoreLibPath)' == ''">$(GameRoot)/BepInEx/plugins/CUCoreLib.dll</CUCoreLibPath>
    <NeiAssemblyPath Condition="'$(NeiAssemblyPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'dist', 'NotEnoughItems', 'NotEnoughItems.dll'))</NeiAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SkipRecipeTests)' == 'true'">
    <!-- The two configurations have different runtime dependencies and must not share a .deps.json. -->
    <OutputPath>bin/$(Configuration)/core-only/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/core-only/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;BookmarkParityTests.cs;PinyinSearchTests.cs;TogetherCraftRequestTests.cs;$(NeiSourceDir)Integrations/TogetherCraftRequest.cs;$(NeiSourceDir)Bookmarks/BookmarkBoardPaging.cs;$(NeiSourceDir)Bookmarks/BookmarkShortcut.cs;$(NeiSourceDir)Bookmarks/BookmarkHelp.cs;$(NeiSourceDir)Catalog/PinyinSearch.cs;$(NeiSourceDir)UI/Layout/PanelLayoutDrag.cs;$(NeiSourceDir)Input/SlotQuantity.cs" />
    <Compile Include="RecipeListLayoutTests.cs;HistoryCatalogTests.cs;$(NeiSourceDir)UI/Layout/RecipeListLayout.cs;$(NeiSourceDir)UI/Screens/RecipeGridLayout.cs;$(NeiSourceDir)UI/Screens/RecipePageLayout.cs;$(NeiSourceDir)Input/TooltipPlacement.cs" />
    <Compile Include="$(NeiSourceDir)Catalog/NeiSearch.cs;$(NeiSourceDir)UI/Layout/NeiLayout.cs;$(NeiSourceDir)Bookmarks/BookmarkBook.cs;$(NeiSourceDir)UI/Styling/NeiAssets.cs;$(NeiSourceDir)UI/Styling/ModernityFrames.cs;$(NeiSourceDir)Input/DragInputPolicy.cs;$(NeiSourceDir)Integrations/CheatPermission.cs;$(NeiSourceDir)Input/TabFocusPolicy.cs" />
    <Compile Include="ButtonVisualTests.cs;$(NeiSourceDir)UI/Styling/ButtonVisual.cs;$(NeiSourceDir)UI/Styling/ButtonSlicePixels.cs" />
    <Compile Include="LocalizationTests.cs;$(NeiSourceDir)Localization/NeiText.cs" />
    <Content Include="../../Lang/en_us.json;../../Lang/zh_cn.json" Link="Lang/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../Lang/en_us.json" LogicalName="Lang/en_us.json" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)/Newtonsoft.Json.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkipRecipeTests)' != 'true'">
    <!-- Exercise the public API in the built plugin; this project does not rebuild or install it. -->
    <Reference Include="NotEnoughItems" HintPath="$(NeiAssemblyPath)" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" />
    <Reference Include="CUCoreLib" HintPath="$(CUCoreLibPath)" />
    <Reference Include="BepInEx" HintPath="$(GameRoot)/BepInEx/core/BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(GameRoot)/BepInEx/core/0Harmony.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" />
    <Compile Include="TooltipSmoke.cs;SurfaceSmoke.cs;CatalogQuantityTests.cs;GuiArtworkTests.cs;TogetherCheatSmoke.cs" />
    <None Include="$(GameRoot)/BepInEx/plugins/Together/CasualtiesMP.dll;$(GameRoot)/BepInEx/plugins/Together/LiteNetLib.dll"
      Link="Together/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
      Condition="Exists('$(GameRoot)/BepInEx/plugins/Together/CasualtiesMP.dll') and Exists('$(GameRoot)/BepInEx/plugins/Together/LiteNetLib.dll')" />
    <None Include="$(GameRoot)/BepInEx/plugins/JustUnknownCharacters.dll" Link="JustUnknownCharacters.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(GameRoot)/BepInEx/plugins/JustUnknownCharacters.dll')" />
    <Compile Include="RecipeMethodsTests.cs;$(NeiSourceDir)Catalog/RecipeMethods.cs;CatalogListingTests.cs;$(NeiSourceDir)Catalog/CatalogListing.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SkipRecipeTests)' != 'true'">
    <DefineConstants>$(DefineConstants);RECIPE_TESTS</DefineConstants>
  </PropertyGroup>
  <Target Name="CheckTestReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')" Text="Casualties: Unknown assemblies not found. Set -p:GameRoot=..." />
    <Error Condition="'$(SkipRecipeTests)' != 'true' and !Exists('$(NeiAssemblyPath)')" Text="Run scripts/Build.ps1 first, set -p:NeiAssemblyPath=..., or pass -p:SkipRecipeTests=true." />
  </Target>
</Project>
