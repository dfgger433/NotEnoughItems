<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <NeiSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'src', 'NotEnoughItems'))</NeiSourceDir>
    <GameRoot Condition="'$(GameRoot)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</GameRoot>
    <ManagedDir>$(GameRoot)/CasualtiesUnknown_Data/Managed</ManagedDir>
    <CUCoreLibPath Condition="'$(CUCoreLibPath)' == ''">$(GameRoot)/BepInEx/plugins/CUCoreLib.dll</CUCoreLibPath>
    <NeiAssemblyPath Condition="'$(NeiAssemblyPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'dist', 'NotEnoughItems.dll'))</NeiAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SkipRecipeTests)' == 'true'">
    <!-- The two configurations have different runtime dependencies and must not share a .deps.json. -->
    <OutputPath>bin/$(Configuration)/core-only/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/core-only/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;BookmarkParityTests.cs;PinyinSearchTests.cs;$(NeiSourceDir)BookmarkBoardPaging.cs;$(NeiSourceDir)BookmarkShortcut.cs;$(NeiSourceDir)BookmarkHelp.cs;$(NeiSourceDir)PinyinSearch.cs;$(NeiSourceDir)PanelLayoutDrag.cs;$(NeiSourceDir)SlotQuantity.cs" />
    <Compile Include="RecipeListLayoutTests.cs;HistoryCatalogTests.cs;$(NeiSourceDir)RecipeListLayout.cs;$(NeiSourceDir)Screens/RecipeGridLayout.cs;$(NeiSourceDir)Screens/RecipePageLayout.cs;$(NeiSourceDir)TooltipPlacement.cs" />
    <Compile Include="$(NeiSourceDir)NeiSearch.cs;$(NeiSourceDir)NeiLayout.cs;$(NeiSourceDir)BookmarkBook.cs;$(NeiSourceDir)NeiAssets.cs;$(NeiSourceDir)ModernityFrames.cs;$(NeiSourceDir)DragInputPolicy.cs;$(NeiSourceDir)CheatPermission.cs;$(NeiSourceDir)TabFocusPolicy.cs" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkipRecipeTests)' != 'true'">
    <!-- Exercise the public API in the built plugin; this project does not rebuild or install it. -->
    <Reference Include="NotEnoughItems" HintPath="$(NeiAssemblyPath)" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" />
    <Reference Include="CUCoreLib" HintPath="$(CUCoreLibPath)" />
    <Reference Include="BepInEx" HintPath="$(GameRoot)/BepInEx/core/BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(GameRoot)/BepInEx/core/0Harmony.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" />
    <Compile Include="TooltipSmoke.cs;SurfaceSmoke.cs;CatalogQuantityTests.cs" />
    <None Include="$(GameRoot)/BepInEx/plugins/JustUnknownCharacters.dll" Link="JustUnknownCharacters.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(GameRoot)/BepInEx/plugins/JustUnknownCharacters.dll')" />
    <Compile Include="RecipeMethodsTests.cs;$(NeiSourceDir)RecipeMethods.cs;CatalogListingTests.cs;$(NeiSourceDir)CatalogListing.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SkipRecipeTests)' != 'true'">
    <DefineConstants>$(DefineConstants);RECIPE_TESTS</DefineConstants>
  </PropertyGroup>
  <Target Name="CheckTestReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')" Text="Casualties: Unknown assemblies not found. Set -p:GameRoot=..." />
    <Error Condition="'$(SkipRecipeTests)' != 'true' and !Exists('$(NeiAssemblyPath)')" Text="Build NotEnoughItems into dist first, set -p:NeiAssemblyPath=..., or pass -p:SkipRecipeTests=true." />
  </Target>
</Project>
