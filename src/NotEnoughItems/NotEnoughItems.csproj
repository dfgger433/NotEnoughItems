<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'dist'))</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Not Enough Items for Casualties: Unknown</Description>
    <GameRoot Condition="'$(GameRoot)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</GameRoot>
    <ManagedDir>$(GameRoot)\CasualtiesUnknown_Data\Managed</ManagedDir>
    <BepInExDir>$(GameRoot)\BepInEx</BepInExDir>
    <CUCoreLibPath Condition="'$(CUCoreLibPath)' == ''">$(BepInExDir)\plugins\CUCoreLib.dll</CUCoreLibPath>
    <NeiAssetDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'Assets', 'NotEnoughItems'))</NeiAssetDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.dll;$(BepInExDir)\core\0Harmony.dll;$(CUCoreLibPath)" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll;$(ManagedDir)\UnityEngine.dll;$(ManagedDir)\UnityEngine.CoreModule.dll;$(ManagedDir)\UnityEngine.ImageConversionModule.dll;$(ManagedDir)\UnityEngine.Physics2DModule.dll;$(ManagedDir)\UnityEngine.IMGUIModule.dll;$(ManagedDir)\UnityEngine.InputLegacyModule.dll;$(ManagedDir)\UnityEngine.TextRenderingModule.dll;$(ManagedDir)\UnityEngine.UIModule.dll;$(ManagedDir)\UnityEngine.UI.dll;$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Content Include="$(NeiAssetDir)**/*" Link="assets/notenoughitems/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- An exported or restored spritesheet can have an older timestamp than the stale loose copy. -->
    <Content Update="$(NeiAssetDir)textures/gui/sprites/checkbox.png" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="$(NeiAssetDir)**/*.png"
      LogicalName="assets/notenoughitems/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginVersionSource>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginVersionSource)" Lines="namespace NotEnoughItems { internal static class BuildVersion { internal const string Value = &quot;$(Version)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginVersionSource)" />
      <FileWrites Include="$(PluginVersionSource)" />
    </ItemGroup>
  </Target>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Casualties: Unknown assemblies not found. Set -p:GameRoot=..." />
    <Error Condition="!Exists('$(CUCoreLibPath)')" Text="CUCoreLib.dll not found. Install CUCoreLib or set -p:CUCoreLibPath=..." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="BepInEx not found in GameRoot." />
  </Target>
</Project>
