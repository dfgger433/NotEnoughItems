<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.2.9</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Not Enough Items for Casualties: Unknown</Description>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..</GameRoot>
    <ManagedDir>$(GameRoot)\CasualtiesUnknown_Data\Managed</ManagedDir>
    <BepInExDir>$(GameRoot)\BepInEx</BepInExDir>
    <CUCoreLibPath Condition="'$(CUCoreLibPath)' == ''">$(BepInExDir)\plugins\CUCoreLib.dll</CUCoreLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="$(BepInExDir)\core\BepInEx.dll;$(BepInExDir)\core\0Harmony.dll;$(CUCoreLibPath)" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll;$(ManagedDir)\UnityEngine.dll;$(ManagedDir)\UnityEngine.CoreModule.dll;$(ManagedDir)\UnityEngine.ImageConversionModule.dll;$(ManagedDir)\UnityEngine.Physics2DModule.dll;$(ManagedDir)\UnityEngine.IMGUIModule.dll;$(ManagedDir)\UnityEngine.InputLegacyModule.dll;$(ManagedDir)\UnityEngine.TextRenderingModule.dll;$(ManagedDir)\UnityEngine.UIModule.dll;$(ManagedDir)\UnityEngine.UI.dll;$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <NeiAsset Include="assets\notenoughitems\**\*.png;assets\notenoughitems\**\*.json;assets\notenoughitems\**\*.mcmeta;assets\notenoughitems\**\LICENSE.txt;assets\notenoughitems\**\SOURCES.md" />
    <EmbeddedResource Include="assets\notenoughitems\**\*.png"
      LogicalName="assets/notenoughitems/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <None Update="@(NeiAsset)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Casualties: Unknown assemblies not found. Set -p:GameRoot=..." />
    <Error Condition="!Exists('$(CUCoreLibPath)')" Text="CUCoreLib.dll not found. Install CUCoreLib or set -p:CUCoreLibPath=..." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="BepInEx not found in GameRoot." />
  </Target>
  <Target Name="Install" DependsOnTargets="Build">
    <PropertyGroup>
      <PluginDir>$(BepInExDir)\plugins\NotEnoughItems</PluginDir>
      <AssetDir>$(PluginDir)\assets\notenoughitems</AssetDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <ItemGroup>
      <LegacyAsset Include="$(PluginDir)\Textures\background-bookmarks.png" Condition="Exists('$(PluginDir)\Textures\background-bookmarks.png')" Destination="$(AssetDir)\textures\gui\backgrounds\bookmarks.png" />
      <LegacyAsset Include="$(PluginDir)\Textures\background-catalog.png" Condition="Exists('$(PluginDir)\Textures\background-catalog.png')" Destination="$(AssetDir)\textures\gui\backgrounds\catalog.png" />
      <LegacyAsset Include="$(PluginDir)\Textures\background-options.png" Condition="Exists('$(PluginDir)\Textures\background-options.png')" Destination="$(AssetDir)\textures\gui\backgrounds\options.png" />
      <LegacyAsset Include="$(PluginDir)\Textures\background-recipe.png" Condition="Exists('$(PluginDir)\Textures\background-recipe.png')" Destination="$(AssetDir)\textures\gui\backgrounds\recipe.png" />
      <LegacyAsset Include="$(PluginDir)\Textures\background.png" Condition="Exists('$(PluginDir)\Textures\background.png')">
        <Destination>$(AssetDir)\textures\gui\backgrounds\default.png</Destination>
      </LegacyAsset>
    </ItemGroup>
    <Copy SourceFiles="%(LegacyAsset.Identity)" DestinationFiles="%(LegacyAsset.Destination)"
      Condition="'%(LegacyAsset.Identity)' != '' and !Exists('%(LegacyAsset.Destination)')" />
    <ItemGroup>
      <SkinFileToInstall Include="@(NeiAsset)"
        Condition="!Exists('$(AssetDir)\%(NeiAsset.RecursiveDir)%(NeiAsset.Filename)%(NeiAsset.Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(SkinFileToInstall)"
      DestinationFiles="@(SkinFileToInstall->'$(AssetDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
